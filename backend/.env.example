# ==============================================================================
# PDFBuddy Backend Environment Configuration
# ==============================================================================
# Neon Serverless PostgreSQL connection string (include ?sslmode=require)
DATABASE_URL=

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# JWT Session Security (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# Environment Mode: 'development' (default) or 'production'
ENVIRONMENT=development

# Frontend Application Origin & CORS Allowlist
# Production origin: https://pdfbuddy-platform.vercel.app
# Local development origin: http://localhost:5173
# Note: Wildcard origins ('*') are strictly prohibited with cookie authentication
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=https://pdfbuddy-platform.vercel.app,http://localhost:5173

# AI Model: Google AI Studio Gemini API Key
GEMINI_API_KEY=

# Storage: Cloudflare R2 Standard Storage (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
